---
import BaseLayout from "./BaseLayout.astro";
const { frontmatter } = Astro.props;
const tags = frontmatter.tags || [];
---

<BaseLayout pageTitle={frontmatter.title}>
  <p class="text-ctp-subtext0 text-sm">{frontmatter.pubDate.toString().slice(0, 10)}</p>
  <p class="italic text-ctp-subtext1 my-1">{frontmatter.description}</p>
  <p class="text-ctp-subtext0 text-sm mb-4">Written by {frontmatter.author}</p>
  <img src={frontmatter.image.url} width="300" alt={frontmatter.image.alt} class="rounded-lg my-4" />

  <div class="flex flex-wrap gap-2 my-4">
    {
      tags.map((tag: any) => (
        <a
          href={`/tags/${tag}`}
          class="px-3 py-1 rounded-full border border-ctp-mauve text-ctp-mauve text-sm font-medium hover:bg-ctp-mauve hover:text-ctp-base transition-colors"
        >
          {tag}
        </a>
      ))
    }
  </div>
  <slot />
</BaseLayout>
