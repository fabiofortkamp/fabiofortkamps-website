---
// PROTOTYPE (issue #4), variant C: "Field lines". Editorial and bold: a large
// serif name over faint dipole field lines, Featured Projects as a big-type
// index, the latest Post as a single feature, a bar-magnet mark.
import {
  name,
  tagline,
  pitch,
  featured,
  more,
  posts,
  nav,
  profiles,
  years,
  formatDate,
} from "./content";

// Dipole field lines, r = L sin²θ, axis along x, lobes above and below.
const rMin = 14;
const lines = [50, 85, 130, 190, 265, 360, 480, 640].map((L) => {
  const t0 = Math.asin(Math.sqrt(rMin / L));
  const pts: string[] = [];
  for (let i = 0; i <= 160; i++) {
    const t = t0 + ((Math.PI - 2 * t0) * i) / 160;
    const r = L * Math.sin(t) ** 2;
    pts.push(`${(r * Math.cos(t)).toFixed(1)} ${(-r * Math.sin(t)).toFixed(1)}`);
  }
  return `M${pts.join("L")}`;
});
const post = posts[0];
const status = { active: "Active", finished: "Finished", archived: "Archived" };
---

<div class="page">
  <header class="head">
    <a class="brand" href="/">
      <svg class="magnet" viewBox="0 0 28 10" aria-hidden="true">
        <rect x="0" y="0" width="14" height="10" class="n"></rect>
        <rect x="14" y="0" width="14" height="10" class="s"></rect>
      </svg>
      <span>{name}</span>
    </a>
    <div class="controls">
      <button class="theme" data-theme-toggle aria-label="Switch theme">
        <svg viewBox="0 0 16 16" width="18" height="18" aria-hidden="true"
          ><circle cx="8" cy="8" r="6.5" fill="none" stroke="currentColor"
          ></circle><path d="M8 1.5a6.5 6.5 0 0 1 0 13z" fill="currentColor"
          ></path></svg
        >
      </button>
      <button
        class="menu"
        data-menu-toggle
        aria-expanded="false"
        aria-controls="c-nav">Menu</button
      >
    </div>
    <nav id="c-nav" class="nav" aria-label="Main">
      <ul>
        {
          nav.map((n, i) => (
            <li>
              <a href={n.href} aria-current={i === 0 ? "page" : undefined}>
                {n.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </header>

  <main>
    <section class="hero">
      <svg class="field" viewBox="-330 -330 660 660" aria-hidden="true">
        <g>
          {lines.map((d) => <path d={d} />)}
        </g>
        <g transform="scale(1,-1)">
          {lines.map((d) => <path d={d} />)}
        </g>
        <rect x="-14" y="-6" width="14" height="12" class="n"></rect>
        <rect x="0" y="-6" width="14" height="12" class="s"></rect>
      </svg>
      <h1>
        <span>Fábio P.</span>
        <span>Fortkamp</span>
      </h1>
      <p class="tagline">{tagline}</p>
      <p class="pitch">{pitch}</p>
    </section>

    <section aria-labelledby="c-work">
      <h2 id="c-work">Selected work</h2>
      <ol class="index">
        {
          featured.map((p, i) => (
            <li>
              <a href={`/projects/${p.slug}/`} class="row">
                <span class="n-idx">{String(i + 1).padStart(2, "0")}</span>
                <span class="title">{p.title}</span>
                <span class="when">
                  {status[p.status]} · {years(p)}
                </span>
                <span class="sum">{p.summary}</span>
                <span class="stack">
                  {p.role} — {p.stack.join(", ")}
                </span>
              </a>
            </li>
          ))
        }
      </ol>
      <p class="also">
        Also:{" "}
        {
          more.map((p, i) => (
            <>
              <a href={`/projects/${p.slug}/`}>{p.title}</a>
              {i < more.length - 2 ? ", " : i === more.length - 2 ? " and " : ". "}
            </>
          ))
        }
        <a href="/projects/" class="all">All projects →</a>
      </p>
    </section>

    <section aria-labelledby="c-writing">
      <h2 id="c-writing">Latest writing</h2>
      <article class="feature">
        {
          post.series && (
            <p class="series">
              {post.series.title} — Part {post.series.part}
            </p>
          )
        }
        <h3><a href="/writing/">{post.title}</a></h3>
        <p class="desc">{post.description}</p>
        <p class="date">
          <time datetime={post.date}>{formatDate(post.date)}</time>
        </p>
      </article>
    </section>
  </main>

  <footer class="foot">
    <a class="hello" href="#email">Write to me →</a>
    <ul class="profiles">
      {
        profiles.map((p) => (
          <li>
            <a href={p.href}>{p.label}</a>
          </li>
        ))
      }
      <li><a href="/colophon/">Colophon</a></li>
    </ul>
  </footer>
</div>

<style>
  .page {
    max-width: 44rem;
    margin: 0 auto;
    padding: 0 1.25rem 6rem;
    font-size: 1.0625rem;
    line-height: 1.6;
    overflow-x: clip;
  }
  a {
    color: inherit;
    text-decoration: none;
  }
  .n {
    fill: var(--pole);
  }
  .s {
    fill: var(--accent);
  }

  /* Header */
  .head {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem 1rem;
    padding: 1.5rem 0;
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    font-family: var(--font-display);
    font-size: 1.4rem;
    line-height: 1;
  }
  .magnet {
    width: 1.6rem;
    height: auto;
  }
  .controls {
    display: flex;
    gap: 0.5rem;
    align-items: center;
  }
  .menu,
  .theme {
    color: var(--muted);
    cursor: pointer;
    padding: 0.25rem;
  }
  .menu:hover,
  .theme:hover {
    color: var(--accent);
  }
  .nav {
    display: none;
    width: 100%;
  }
  .head:has([aria-expanded="true"]) .nav {
    display: block;
  }
  .nav ul {
    display: flex;
    flex-direction: column;
  }
  .nav a {
    display: block;
    padding: 0.35rem 0;
    color: var(--muted);
  }
  .nav a:hover {
    color: var(--fg);
  }
  .nav a[aria-current="page"] {
    color: var(--fg);
    text-decoration: underline;
    text-decoration-color: var(--accent);
    text-decoration-thickness: 2px;
    text-underline-offset: 0.35em;
  }
  @media (min-width: 40rem) {
    .head {
      flex-wrap: nowrap;
    }
    .menu {
      display: none;
    }
    .nav {
      display: block;
      width: auto;
      margin-left: auto;
    }
    .nav ul {
      flex-direction: row;
      gap: 1.5rem;
    }
    .controls {
      order: 3;
    }
  }

  /* Hero */
  .hero {
    position: relative;
    padding: 4rem 0 4.5rem;
  }
  .field {
    position: absolute;
    z-index: -1;
    top: 50%;
    left: 80%;
    width: 46rem;
    max-width: none;
    transform: translate(-50%, -50%);
    pointer-events: none;
    -webkit-mask-image: radial-gradient(closest-side, #000 55%, transparent);
    mask-image: radial-gradient(closest-side, #000 55%, transparent);
  }
  @media (max-width: 40rem) {
    .field {
      left: 86%;
      top: 22%;
      width: 30rem;
    }
  }
  .field path {
    fill: none;
    stroke: var(--field);
    stroke-width: 1.1;
  }
  h1 {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(3.4rem, 13vw, 6.25rem);
    line-height: 0.92;
    letter-spacing: -0.02em;
  }
  h1 span {
    display: block;
  }
  h1 span + span {
    font-style: italic;
    padding-left: 0.5em;
  }
  .tagline {
    margin-top: 1.25rem;
    font-family: var(--font-display);
    font-style: italic;
    font-size: 1.5rem;
    color: var(--accent);
  }
  .pitch {
    max-width: 33rem;
    margin-top: 1rem;
    font-size: 1.25rem;
    line-height: 1.5;
    text-wrap: pretty;
  }

  /* Sections */
  h2 {
    font-size: 0.8rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--muted);
    margin-bottom: 0.5rem;
  }
  section + section {
    margin-top: 4rem;
  }

  /* Index */
  .index li {
    border-top: 1px solid var(--rule);
  }
  .index li:last-child {
    border-bottom: 1px solid var(--rule);
  }
  .row {
    display: grid;
    grid-template-columns: 2.25rem 1fr auto;
    column-gap: 0.75rem;
    padding: 1.1rem 0 1.25rem;
  }
  .n-idx {
    grid-row: span 3;
    padding-top: 0.85rem;
    font-size: 0.8rem;
    color: var(--muted);
    font-variant-numeric: tabular-nums;
  }
  .title {
    font-family: var(--font-display);
    font-size: clamp(2rem, 6vw, 2.6rem);
    line-height: 1.1;
    transition: color 0.15s;
  }
  .row:hover .title {
    color: var(--accent);
  }
  .when {
    align-self: center;
    font-size: 0.8rem;
    color: var(--muted);
    white-space: nowrap;
  }
  .sum {
    grid-column: 2 / -1;
    margin-top: 0.25rem;
  }
  .stack {
    grid-column: 2 / -1;
    font-size: 0.9rem;
    color: var(--muted);
  }
  .also {
    margin-top: 1.25rem;
    color: var(--muted);
  }
  .also a {
    color: var(--fg);
    text-decoration: underline;
    text-decoration-color: var(--rule);
    text-underline-offset: 0.2em;
  }
  .also a:hover {
    text-decoration-color: var(--accent);
  }
  .also .all {
    white-space: nowrap;
    color: var(--accent);
    text-decoration: none;
  }

  /* Feature */
  .feature {
    padding-top: 0.5rem;
    border-top: 1px solid var(--rule);
  }
  .series {
    margin-top: 0.75rem;
    font-size: 0.9rem;
    color: var(--accent);
  }
  h3 {
    font-family: var(--font-display);
    font-style: italic;
    font-weight: 400;
    font-size: clamp(2rem, 6vw, 2.75rem);
    line-height: 1.1;
    margin: 0.25rem 0 0.6rem;
  }
  h3 a:hover {
    color: var(--accent);
  }
  .desc {
    max-width: 34rem;
  }
  .date {
    margin-top: 0.5rem;
    font-size: 0.9rem;
    color: var(--muted);
  }

  /* Footer */
  .foot {
    margin-top: 5rem;
    padding-top: 2rem;
    border-top: 1px solid var(--rule);
  }
  .hello {
    font-family: var(--font-display);
    font-size: clamp(2.2rem, 7vw, 3rem);
    line-height: 1;
  }
  .hello:hover {
    color: var(--accent);
  }
  .profiles {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1.25rem;
    margin-top: 1.5rem;
    color: var(--muted);
  }
  .profiles a:hover {
    color: var(--accent);
  }
</style>
