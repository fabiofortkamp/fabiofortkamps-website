---
// PROTOTYPE (issue #4), variant A: "Paper and figures". The page reads like
// a paper: an abstract for the pitch, Featured Projects as captioned
// figures, other projects as a table, Posts as a reference list.
import {
  name,
  tagline,
  pitch,
  featured,
  more,
  posts,
  nav,
  profiles,
  years,
  formatDate,
} from "./content";

const status = { active: "Active", finished: "Finished", archived: "Archived" };
---

<div class="page">
  <header class="head">
    <a class="name" href="/">{name}</a>
    <button
      class="menu"
      data-menu-toggle
      aria-expanded="false"
      aria-controls="a-nav">Menu</button
    >
    <nav id="a-nav" class="nav" aria-label="Main">
      <ul>
        {
          nav.map((n, i) => (
            <li>
              <a href={n.href} aria-current={i === 0 ? "page" : undefined}>
                {n.label}
              </a>
            </li>
          ))
        }
      </ul>
      <button class="theme" data-theme-toggle aria-label="Switch theme">
        <svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true"
          ><circle cx="8" cy="8" r="6.5" fill="none" stroke="currentColor"
          ></circle><path d="M8 1.5a6.5 6.5 0 0 1 0 13z" fill="currentColor"
          ></path></svg
        >
      </button>
    </nav>
  </header>

  <main>
    <section class="abstract" aria-labelledby="a-abstract">
      <p class="label" id="a-abstract">{tagline}</p>
      <p class="pitch">{pitch}</p>
    </section>

    <section aria-labelledby="a-featured">
      <h2 id="a-featured"><span class="num">1</span> Featured projects</h2>
      <div class="figures">
        {
          featured.map((p, i) => (
            <figure class="figure">
              <a class="plate" href={`/projects/${p.slug}/`}>
                <span class="plate-title">{p.title}</span>
                <span class="plate-stack">{p.stack.join(" · ")}</span>
              </a>
              <figcaption>
                <span class="fig">Fig. {i + 1}.</span> {p.summary}{" "}
                <span class="meta">
                  {p.role}. {status[p.status]}, {years(p)}.
                </span>
              </figcaption>
            </figure>
          ))
        }
      </div>

      <table class="table">
        <caption><span class="fig">Table 1.</span> Other projects.</caption>
        <thead>
          <tr><th scope="col">Project</th><th scope="col">Role</th><th
              scope="col"
              class="r">Years</th></tr>
        </thead>
        <tbody>
          {
            more.map((p) => (
              <tr>
                <td>
                  <a href={`/projects/${p.slug}/`}>{p.title}</a>
                  {p.parent && <span class="part"> (part of {p.parent})</span>}
                </td>
                <td>{p.role}</td>
                <td class="r num-cell">{years(p)}</td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </section>

    <section aria-labelledby="a-writing">
      <h2 id="a-writing"><span class="num">2</span> Latest writing</h2>
      <ol class="refs">
        {
          posts.map((post, i) => (
            <li>
              <span class="ref">[{i + 1}]</span>
              <div>
                <a href="/writing/">{post.title}</a>.{" "}
                {post.series && (
                  <em>
                    {post.series.title}, part {post.series.part}.
                  </em>
                )}{" "}
                <time datetime={post.date}>{formatDate(post.date)}</time>.
                <p class="desc">{post.description}</p>
              </div>
            </li>
          ))
        }
      </ol>
    </section>
  </main>

  <footer class="foot">
    <p>
      <span class="label">Correspondence</span>
      <a href="#email">fabio@…</a>
      {profiles.map((p) => <a href={p.href}>{p.label}</a>)}
    </p>
    <p class="colophon"><a href="/colophon/">Colophon</a></p>
  </footer>
</div>

<style>
  .page {
    max-width: 42rem;
    margin: 0 auto;
    padding: 0 1.25rem 6rem;
    font-size: 1.1875rem;
    line-height: 1.6;
    font-optical-sizing: auto;
  }
  a {
    color: var(--fg);
    text-decoration: underline;
    text-decoration-color: var(--accent);
    text-decoration-thickness: 1px;
    text-underline-offset: 0.18em;
  }
  a:hover {
    color: var(--accent);
  }

  /* Header */
  .head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.5rem 1.5rem;
    padding: 2rem 0 1rem;
    border-bottom: 1px solid var(--fg);
  }
  .name {
    font-size: 1.35rem;
    font-weight: 600;
    letter-spacing: -0.01em;
    text-decoration: none;
  }
  .nav {
    display: none;
    width: 100%;
    align-items: center;
    justify-content: space-between;
  }
  .head:has([aria-expanded="true"]) .nav {
    display: flex;
  }
  .nav ul {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }
  .nav a,
  .menu {
    font-variant-caps: all-small-caps;
    letter-spacing: 0.06em;
    font-size: 1.1rem;
    text-decoration: none;
    color: var(--muted);
  }
  .nav a[aria-current="page"] {
    color: var(--fg);
    border-bottom: 1px solid var(--accent);
  }
  .menu {
    cursor: pointer;
  }
  .theme {
    color: var(--muted);
    padding: 0.25rem;
    cursor: pointer;
  }
  .theme:hover {
    color: var(--accent);
  }
  @media (min-width: 40rem) {
    .menu {
      display: none;
    }
    .nav {
      display: flex;
      width: auto;
      gap: 1.25rem;
    }
    .nav ul {
      flex-direction: row;
      gap: 1.25rem;
    }
  }

  /* Abstract */
  .abstract {
    margin: 3rem 0 3.5rem;
  }
  .label,
  .fig {
    font-variant-caps: all-small-caps;
    letter-spacing: 0.08em;
    font-weight: 600;
    color: var(--accent);
  }
  .abstract .label {
    margin-bottom: 0.5rem;
  }
  .pitch {
    font-size: clamp(1.5rem, 4.2vw, 1.95rem);
    line-height: 1.32;
    font-weight: 400;
    letter-spacing: -0.012em;
    text-wrap: pretty;
  }

  /* Sections */
  h2 {
    display: flex;
    align-items: baseline;
    gap: 0.75rem;
    font-size: 1.35rem;
    font-weight: 600;
    margin: 0 0 1.5rem;
    padding-bottom: 0.35rem;
    border-bottom: 1px solid var(--rule);
  }
  .num {
    color: var(--accent);
    font-variant-numeric: oldstyle-nums;
    font-weight: 400;
  }
  section + section {
    margin-top: 3.5rem;
  }

  /* Figures */
  .figures {
    display: grid;
    gap: 2rem 1.5rem;
  }
  @media (min-width: 40rem) {
    .figures {
      grid-template-columns: 1fr 1fr;
    }
  }
  .plate {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    min-height: 8.5rem;
    padding: 1rem 1.1rem;
    background: var(--plate);
    border: 1px solid var(--rule);
    text-decoration: none;
    transition: border-color 0.15s;
  }
  .plate:hover {
    border-color: var(--accent);
    color: var(--fg);
  }
  .plate-title {
    font-size: 1.7rem;
    font-weight: 500;
    line-height: 1.1;
    letter-spacing: -0.015em;
  }
  .plate-stack {
    font-size: 0.85rem;
    color: var(--muted);
    font-style: italic;
  }
  figcaption {
    margin-top: 0.6rem;
    font-size: 1rem;
    line-height: 1.5;
  }
  .meta {
    color: var(--muted);
  }

  /* Table */
  .table {
    width: 100%;
    margin-top: 3rem;
    font-size: 1rem;
    border-collapse: collapse;
    border-top: 1.5px solid var(--fg);
    border-bottom: 1.5px solid var(--fg);
  }
  caption {
    caption-side: top;
    text-align: left;
    padding-bottom: 0.5rem;
  }
  th {
    text-align: left;
    font-weight: 600;
    border-bottom: 1px solid var(--fg);
    padding: 0.35rem 0.5rem 0.35rem 0;
  }
  td {
    padding: 0.35rem 0.5rem 0.35rem 0;
    vertical-align: top;
  }
  .r {
    text-align: right;
    padding-right: 0;
  }
  .num-cell {
    font-variant-numeric: tabular-nums lining-nums;
    white-space: nowrap;
  }
  .part {
    color: var(--muted);
    font-style: italic;
  }

  /* References */
  .refs li {
    display: grid;
    grid-template-columns: 2.5rem 1fr;
  }
  .ref {
    color: var(--accent);
  }
  .desc {
    color: var(--muted);
    font-size: 1rem;
    margin-top: 0.25rem;
  }

  /* Footer */
  .foot {
    margin-top: 5rem;
    padding-top: 1rem;
    border-top: 1px solid var(--fg);
    font-size: 1rem;
  }
  .foot p:first-child {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1.1rem;
  }
  .colophon {
    margin-top: 0.75rem;
    color: var(--muted);
  }
</style>
